# Example for a future LVGL integration on ESP32-S3-Touch-AMOLED-1.75C.
# sdkconfig.defaults at the project root is the active firmware profile.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# LVGL-specific settings depend on the selected adapter during UI integration.
# Give the display one owner for its tick, task and DMA buffers.
